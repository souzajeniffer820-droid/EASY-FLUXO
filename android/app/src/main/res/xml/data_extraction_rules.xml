<?xml version="1.0" encoding="utf-8"?>
<!--
  O CicloLivre promete que nenhum dado de saúde sai do dispositivo.
  Estas regras desativam o backup em nuvem e a transferência entre aparelhos
  do Android 12+, mantendo o localStorage do WebView fora do Google Drive.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
